<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PORTALX · TODAY" android:textColor="@color/brand_gold" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
    <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/brand_ink" android:textSize="17sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:text="Sign in to PortalX" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#6F5E4A" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" android:text="Your day at a glance" />
    <TextView android:id="@+id/widget_now" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/brand_gold" android:textSize="13sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
